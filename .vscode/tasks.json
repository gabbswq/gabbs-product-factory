{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Factory: instalar landing",
      "type": "shell",
      "command": "npm --prefix landing ci",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Factory: iniciar landing",
      "type": "shell",
      "command": "npm --prefix landing run dev -- --port 5173 --strictPort",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Factory: instalar navegador de testes",
      "type": "shell",
      "command": "npm --prefix landing exec -- playwright install chromium",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Factory: validar landing",
      "type": "shell",
      "command": "npm --prefix landing run verify",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
